# external baseline clones (survey/repro reference, not our code)
external/

# run byproducts that are NOT records: hidden job-id markers, driver logs and
# probe scratch emitted next to the analysis scripts / records they belong to.
# Records live in refine-logs/*.md and state/ — these are transient.
scripts/analysis/.*
refine-logs/.lsmi_*

# session scratch (never a deliverable)
scratchpad/

# quota-patrol byproduct, not a research record: an ~800k-line append-only stream
# from scripts/disk_guard.sh. Ruled 不入库 by DECISION_MEMO_pending D5 — its
# load-bearing sha1 / B2 reconciliation evidence is already written up in
# MORNING_REPORT §6.3 and EXP_mm_segment_keys §1. Kept on disk, out of the ledger.
# NOTE: every OTHER file under slurm/logs/ IS a record and stays tracked.
slurm/logs/disk_guard.log

# VSW pregate: per-fold/per-draw reap-resilience checkpoints (82 MB, 4710 files).
# Reproducible intermediate state; every load-bearing number is in vsw_*_OUT.json.
scripts/analysis/vsw_ckpt/
idea-stage/desc_channel/batch_in_*.jsonl
idea-stage/desc_channel/batch_out_*.jsonl
idea-stage/desc_channel/feats/
idea-stage/desc_channel/__pycache__/

# TEXT_MERGE
idea-stage/text_merge/feats/
idea-stage/text_merge/__pycache__/

# derived feature caches / probe outputs (regenerable, not records)
idea-stage/*/out/*.npz
idea-stage/*/out/*.npy

# R16 detector prediction dumps: regenerable from scripts/r16_detbase/run_af.py in ~4 min/seed
idea-stage/*/out/preds_*.json

# ---- label-free frame-level repro campaign (Phase A route 2) ----
# Third-party method repos cloned verbatim for reproduction, plus their
# downloaded checkpoints. Commits are pinned in
# idea-stage/repro_campaign/MODEL_ASSETS_STATUS.md; nothing here is our code.
third_party/*
# actionformer was vendored+tracked before this campaign; keep it tracked.
!third_party/actionformer

# model weights, belt-and-braces on top of the existing *.pt / *.pth rules.
# Every checkpoint this campaign downloads lives in third_party/_ckpt/ or the
# HF cache (~/.cache/huggingface, outside the repo); these patterns just make
# sure a stray copy elsewhere can never be staged.
*.ckpt
*.safetensors

# repro campaign smoke scratch: extracted JPEG frames + one copied mp4 for the
# single-video smoke tests. Regenerable; the results are recorded in
# idea-stage/repro_campaign/MODEL_ASSETS_STATUS.md.
idea-stage/repro_campaign/smoke/lavad_ds/

# experiment outputs (checkpoints, scores, logs, metrics) — never tracked
runs/

# archived old-era files that were never tracked stay untracked
archive/idea-stage/
archive/refine-logs/
archive/root-2026-08/sout2.txt
