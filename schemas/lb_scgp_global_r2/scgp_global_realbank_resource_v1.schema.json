          "required": [
            "read_validation_label",
            "read_validation_content",
            "read_test_label",
            "read_test_content",
            "read_held_content",
            "read_cache_artifact",
            "read_query_z",
            "read_query_labels",
            "read_teacher_artifact",
            "read_non_allowlisted_train_bank",
            "open_mutated_train_bank_hash"
          ]
        }
      },
      "required": ["all_reject", "cases"]
    },
    "structural_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_science": {"const": false, "type": "boolean"},
        "policy": {"const": "synthetic_label_blind_placeholder_b_struct_opens_structural_code_path", "type": "string"},
        "rank_cap_r": {"const": 8, "type": "integer"},
        "m_scale": {"const": 36, "type": "integer"},
        "note": {"type": "string"},
        "per_dataset_b_struct_l2": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["is_science", "policy", "rank_cap_r", "m_scale", "note", "per_dataset_b_struct_l2"]
    },
    "allowed_reads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorized_train_bank_read_count": {"const": 2, "type": "integer"},
        "banks": {
          "type": "array",
          "items": {"$ref": "#/definitions/bank_row"},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["authorized_train_bank_read_count", "banks"]
    },
    "gold_isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "only_gold_supervision": {"const": "parent_video_binary_label", "type": "string"},
        "segment_gold_exists": {"const": false, "type": "boolean"},
        "segment_gold_used": {"const": false, "type": "boolean"},
        "train_labels_opened": {"const": false, "type": "boolean"},
        "zero_counters": {"$ref": "#/definitions/zero_counters"}
      },
      "required": ["only_gold_supervision", "segment_gold_exists", "segment_gold_used", "train_labels_opened", "zero_counters"]
    },
    "dirty_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run1_frozen_hashes_bound": {"const": true, "type": "boolean"},
        "source_files_bound": {"const": true, "type": "boolean"},
        "artifact_outputs_excluded_from_source_binding": {"const": true, "type": "boolean"},
        "docs_tracker_post_run_changes_separately_measurable": {"const": true, "type": "boolean"},
        "old_protected_manifest_sha256": {"type": "string"},
        "relevant_tree_sha256": {"type": "string"}
      },
      "required": [
        "run1_frozen_hashes_bound",
        "source_files_bound",
        "artifact_outputs_excluded_from_source_binding",
        "docs_tracker_post_run_changes_separately_measurable",
        "old_protected_manifest_sha256",
        "relevant_tree_sha256"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer_status": {"enum": ["PASS_CANDIDATE", "FAIL"], "type": "string"},
        "semantic_verifier_required": {"const": true, "type": "boolean"},
        "decision_rule": {"type": "string"}
      },
      "required": ["producer_status", "semantic_verifier_required", "decision_rule"]
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_sha256": {"type": "string"},
        "schema_sha256": {"type": "string"},
        "implementation_sha256": {"type": "string"},
        "source_manifest_sha256": {"type": "string"},
        "access_ledger_sha256": {"type": "string"},
        "run1_artifact_sha256": {"type": "string"},
        "run1_lock_sha256": {"type": "string"},
        "train_bank_MHC_sha256": {"type": "string"},
        "train_bank_MHC_zh_sha256": {"type": "string"}
      },
      "required": [
        "config_sha256",
        "schema_sha256",
        "implementation_sha256",
        "source_manifest_sha256",
        "access_ledger_sha256",
        "run1_artifact_sha256",
        "run1_lock_sha256",
        "train_bank_MHC_sha256",
        "train_bank_MHC_zh_sha256"
      ]
    },
    "payload_sha256": {"type": "string"}
  },
  "required": [
    "schema_version",
    "artifact_schema_id",
    "run_id",
    "terminal_state",
    "no_success_claim",
    "decision",
    "authorized_boundary",
    "slurm_policy",
    "config_path",
    "source_manifest_path",
    "access_ledger_path",
    "resource_peak",
    "rank_tail",
    "replay_hashes",
    "robust_coverage",
    "isolation_injection_results",
    "structural_placeholder",
    "allowed_reads",
    "gold_isolation",
    "dirty_binding",
    "acceptance",
    "hashes",
    "payload_sha256"
  ]
}
