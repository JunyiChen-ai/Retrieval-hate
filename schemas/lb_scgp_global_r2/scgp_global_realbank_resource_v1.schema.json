  "properties": {
    "schema_version": {"const": "lb_scgp_global_r2_realbank_resource_manifest_v1", "type": "string"},
    "artifact_schema_id": {"const": "scgp_global_realbank_resource_v1", "type": "string"},
    "run_id": {"const": "LBSCGP-GLOBAL-G0-M0-REALBANK-RESOURCE-v1", "type": "string"},
    "terminal_state": {"enum": ["PRODUCED_PENDING_INDEPENDENT_VERIFY", "FAIL"], "type": "string"},
    "no_success_claim": {"const": true, "type": "boolean"},
    "decision": {"enum": ["GO", "STOP"], "type": "string"},
    "authorized_boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {"const": "LBSCGP-GLOBAL-G0-M0-REALBANK-RESOURCE-v1", "type": "string"},
        "train_bank_static_replay_only": {"const": true, "type": "boolean"},
        "m1_cache_and_later_locked": {"const": true, "type": "boolean"}
      },
      "required": ["run_id", "train_bank_static_replay_only", "m1_cache_and_later_locked"]
    },
    "slurm_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"const": true, "type": "boolean"},
        "conda_env": {"const": "HateVideo", "type": "string"},
        "job_id": {"type": "string"},
        "cpu": {"const": 16, "type": "integer"},
        "ram_gb": {"const": 96, "type": "integer"},
        "gpu": {"const": 0, "type": "integer"},
        "no_time_flag": {"const": true, "type": "boolean"}
      },
      "required": ["required", "conda_env", "job_id", "cpu", "ram_gb", "gpu", "no_time_flag"]
    },
    "config_path": {"type": "string"},
    "source_manifest_path": {"type": "string"},
    "access_ledger_path": {"type": "string"},
    "resource_peak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_peak_rss_bytes": {"minimum": 0, "type": "integer"},
        "cap_bytes": {"const": 103079215104, "type": "integer"},
        "within_cap": {"type": "boolean"},
        "measurement": {"const": "resource.getrusage(RUSAGE_SELF).ru_maxrss", "type": "string"},
        "per_dataset": {
          "type": "array",
          "items": {"$ref": "#/definitions/resource_dataset"},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["job_peak_rss_bytes", "cap_bytes", "within_cap", "measurement", "per_dataset"]
    },
    "rank_tail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_rank_le_d": {"type": "boolean"},
        "per_dataset": {
          "type": "array",
          "items": {"$ref": "#/definitions/rank_dataset"},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["all_rank_le_d", "per_dataset"]
    },
    "replay_hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_match": {"type": "boolean"},
        "per_dataset": {
          "type": "array",
          "items": {"$ref": "#/definitions/replay_dataset"},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["all_match", "per_dataset"]
    },
    "robust_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_open": {"const": true, "type": "boolean"},
        "robust_constraints_enabled": {"const": false, "type": "boolean"},
        "per_dataset": {
          "type": "array",
          "items": {"$ref": "#/definitions/coverage_dataset"},
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["fail_open", "robust_constraints_enabled", "per_dataset"]
    },
    "isolation_injection_results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_reject": {"type": "boolean"},
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read_validation_label": {"const": "REJECT", "type": "string"},
            "read_validation_content": {"const": "REJECT", "type": "string"},
            "read_test_label": {"const": "REJECT", "type": "string"},
            "read_test_content": {"const": "REJECT", "type": "string"},
            "read_held_content": {"const": "REJECT", "type": "string"},
            "read_cache_artifact": {"const": "REJECT", "type": "string"},
            "read_query_z": {"const": "REJECT", "type": "string"},
            "read_query_labels": {"const": "REJECT", "type": "string"},
            "read_teacher_artifact": {"const": "REJECT", "type": "string"},
            "read_non_allowlisted_train_bank": {"const": "REJECT", "type": "string"},
            "open_mutated_train_bank_hash": {"const": "REJECT", "type": "string"}
