{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LB-SCGP Global-R2 realbank static/resource microbenchmark decision",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "resource_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {"enum": ["MHC", "MHC_zh"], "type": "string"},
        "n": {"minimum": 1, "type": "integer"},
        "d": {"minimum": 1, "type": "integer"},
        "q_rank": {"minimum": 0, "type": "integer"},
        "m_scale": {"minimum": 0, "type": "integer"},
        "peak_rss_bytes_after": {"minimum": 0, "type": "integer"}
      },
      "required": ["dataset", "n", "d", "q_rank", "m_scale", "peak_rss_bytes_after"]
    },
    "rank_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {"enum": ["MHC", "MHC_zh"], "type": "string"},
        "d": {"minimum": 1, "type": "integer"},
        "rank_eps": {"minimum": 0, "type": "integer"},
        "rank_le_d": {"type": "boolean"},
        "lambda_d": {"type": "number"},
        "lambda_dplus1": {"type": "number"},
        "positive_eigenmass": {"type": "number"},
        "negative_eigenmass": {"type": "number"},
        "tail_ratio": {"type": "number"},
        "reconstruction_residual": {"type": "number"},
        "status": {"enum": ["PASS", "ENCODER_RANK_GATE_FAIL"], "type": "string"}
      },
      "required": [
        "dataset",
        "d",
        "rank_eps",
        "rank_le_d",
        "lambda_d",
        "lambda_dplus1",
        "positive_eigenmass",
        "negative_eigenmass",
        "tail_ratio",
        "reconstruction_residual",
        "status"
      ]
    },
    "replay_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {"enum": ["MHC", "MHC_zh"], "type": "string"},
        "replay_digest_run1": {"type": "string"},
        "replay_digest_run2": {"type": "string"},
        "match": {"type": "boolean"}
      },
      "required": ["dataset", "replay_digest_run1", "replay_digest_run2", "match"]
    },
    "coverage_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {"enum": ["MHC", "MHC_zh"], "type": "string"},
        "topk": {"minimum": 1, "type": "integer"},
        "median_positive_gap": {"type": "number"},
        "rho_coord": {"type": "number"},
        "robust_query_count": {"minimum": 0, "type": "integer"},
        "total_query_count": {"minimum": 0, "type": "integer"},
        "coverage_fraction": {"minimum": 0, "type": "number"},
        "coverage_gate_pass": {"type": "boolean"},
        "class_stratification": {"const": "deferred_train_labels_not_opened", "type": "string"},
        "safety_claim": {"const": "disabled", "type": "string"}
      },
      "required": [
        "dataset",
        "topk",
        "median_positive_gap",
        "rho_coord",
        "robust_query_count",
        "total_query_count",
        "coverage_fraction",
        "coverage_gate_pass",
        "class_stratification",
        "safety_claim"
      ]
    },
    "bank_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {"enum": ["MHC", "MHC_zh"], "type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string"}
      },
      "required": ["dataset", "path", "sha256"]
    },
    "zero_counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auxiliary_head_route_count": {"const": 0, "type": "integer"},
        "cache_outer_held_content_read_count": {"const": 0, "type": "integer"},
        "cache_outer_held_label_read_count": {"const": 0, "type": "integer"},
        "cache_read_count": {"const": 0, "type": "integer"},
