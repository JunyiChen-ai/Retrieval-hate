        "cache_validation_label_read_count": {"const": 0, "type": "integer"},
        "certificate_read_count": {"const": 0, "type": "integer"},
        "compiler_target_read_count": {"const": 0, "type": "integer"},
        "comparator_freeze_adaptive_query_label_read_count": {"const": 0, "type": "integer"},
        "comparator_freeze_final_test_label_read_count": {"const": 0, "type": "integer"},
        "comparator_freeze_final_test_margin_read_count": {"const": 0, "type": "integer"},
        "comparator_freeze_final_test_prediction_read_count": {"const": 0, "type": "integer"},
        "control_construction_final_test_error_read_count": {"const": 0, "type": "integer"},
        "control_construction_final_test_label_read_count": {"const": 0, "type": "integer"},
        "control_construction_final_test_margin_read_count": {"const": 0, "type": "integer"},
        "control_construction_final_test_prediction_read_count": {"const": 0, "type": "integer"},
        "forbidden_path_read_count": {"const": 0, "type": "integer"},
        "gpu_device_count": {"const": 0, "type": "integer"},
        "held_content_read_count": {"const": 0, "type": "integer"},
        "held_label_read_count": {"const": 0, "type": "integer"},
        "key_selection_route_count": {"const": 0, "type": "integer"},
        "local_v7_pass_evidence_reuse_count": {"const": 0, "type": "integer"},
        "mllm_call_count": {"const": 0, "type": "integer"},
        "mllm_calls_outside_train_cache": {"const": 0, "type": "integer"},
        "model_call_count": {"const": 0, "type": "integer"},
        "network_call_count": {"const": 0, "type": "integer"},
        "non_allowlisted_train_content_read_count": {"const": 0, "type": "integer"},
        "ocr_call_count": {"const": 0, "type": "integer"},
        "pair_triplet_supcon_route_count": {"const": 0, "type": "integer"},
        "performance_evaluation_count": {"const": 0, "type": "integer"},
        "query_labels_read_count": {"const": 0, "type": "integer"},
        "query_z_read_count": {"const": 0, "type": "integer"},
        "reranking_route_count": {"const": 0, "type": "integer"},
        "run3_cache_or_later_attempt_count": {"const": 0, "type": "integer"},
        "sample_weighting_route_count": {"const": 0, "type": "integer"},
        "segment_gold_read_count": {"const": 0, "type": "integer"},
        "teacher_artifact_read_count": {"const": 0, "type": "integer"},
        "teacher_cache_read_count": {"const": 0, "type": "integer"},
        "teacher_cache_write_count": {"const": 0, "type": "integer"},
        "test_content_read_count": {"const": 0, "type": "integer"},
        "test_label_read_count": {"const": 0, "type": "integer"},
        "train_label_read_count": {"const": 0, "type": "integer"},
        "training_call_count": {"const": 0, "type": "integer"},
        "validation_content_read_count": {"const": 0, "type": "integer"},
        "validation_label_read_count": {"const": 0, "type": "integer"}
