                "multi_modal",
                "single_modal",
                "unresolved"
              ]
            },
            "confidence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        }
      }
    },
    "parse_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
