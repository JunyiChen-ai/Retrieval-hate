          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "supported",
                "contradicted",
                "unresolved"
              ]
            },
            "confidence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "context_shift_observable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "confidence"
          ],
          "properties": {
            "state": {
