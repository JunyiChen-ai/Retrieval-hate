        "structural_sign_convention",
        "normal_G_fro_norm",
        "normal_r_l2_norm"
      ],
      "type": "object"
    },
    "artifact_schema_id": {"const": "scgp_global_synth_kkt_payload_v1", "type": "string"},
    "authorized_boundary": {
      "additionalProperties": false,
      "properties": {
        "run3_or_later_locked": {"const": true, "type": "boolean"},
        "run_id": {"const": "LBSCGP-GLOBAL-G0-M0-SYNTH-KKT-v1", "type": "string"},
        "synthetic_only": {"const": true, "type": "boolean"}
      },
      "required": ["run_id", "synthetic_only", "run3_or_later_locked"],
      "type": "object"
    },
    "box_coordinate_normals": {
      "additionalProperties": false,
      "properties": {
        "coordinate_trust": {"$ref": "#/definitions/normal_block"},
        "offdiag_box": {"$ref": "#/definitions/normal_block"},
        "structural_band": {"$ref": "#/definitions/normal_block"}
      },
      "required": ["offdiag_box", "coordinate_trust", "structural_band"],
      "type": "object"
    },
    "case_matrix": {
      "additionalProperties": false,
      "properties": {
        "cases": {"items": {"$ref": "scgp_global_synth_kkt_case_v1.schema.json#"}, "minItems": 6, "type": "array"},
        "status": {"enum": ["PASS", "FAIL"], "type": "string"}
      },
      "required": ["status", "cases"],
      "type": "object"
    },
    "complementarity": {
      "additionalProperties": false,
      "properties": {
        "max_abs": {"maximum": 0.000001, "minimum": 0, "type": "number"},
        "per_family": {"items": {"$ref": "#/definitions/named_metric"}, "type": "array"},
        "status": {"enum": ["PASS", "FAIL"], "type": "string"}
      },
      "required": ["status", "max_abs", "per_family"],
      "type": "object"
    },
    "config_path": {"type": "string"},
    "dirty_binding": {
      "additionalProperties": false,
      "properties": {
        "artifact_outputs_excluded_from_source_binding": {"const": true, "type": "boolean"},
        "docs_tracker_post_run_changes_separately_measurable": {"const": true, "type": "boolean"},
        "old_protected_manifest_sha256": {"type": "string"},
        "relevant_tree_sha256": {"type": "string"},
        "run1_frozen_hashes_bound": {"const": true, "type": "boolean"},
        "source_files_bound": {"const": true, "type": "boolean"}
      },
      "required": [
        "run1_frozen_hashes_bound",
        "source_files_bound",
        "artifact_outputs_excluded_from_source_binding",
        "docs_tracker_post_run_changes_separately_measurable",
        "old_protected_manifest_sha256",
        "relevant_tree_sha256"
      ],
      "type": "object"
    },
    "dual_feasibility": {
      "additionalProperties": false,
      "properties": {
        "affine_unrestricted": {"const": true, "type": "boolean"},
        "linear_multiplier_min": {"minimum": 0, "type": "number"},
        "psd_dual_lambda_min": {"minimum": -0.0000001, "type": "number"},
        "soc_cone_residual_max": {"maximum": 0.0000001, "minimum": 0, "type": "number"},
        "status": {"enum": ["PASS", "FAIL"], "type": "string"}
      },
      "required": [
        "status",
        "linear_multiplier_min",
        "soc_cone_residual_max",
        "psd_dual_lambda_min",
        "affine_unrestricted"
      ],
      "type": "object"
    },
    "duality_gap": {
      "additionalProperties": false,
      "properties": {
        "dual_objective_materialized": {"const": false, "type": "boolean"},
        "gap_pass_claimed": {"const": false, "type": "boolean"},
        "note": {"type": "string"}
      },
      "required": ["dual_objective_materialized", "gap_pass_claimed", "note"],
      "type": "object"
    },
    "gold_isolation": {
      "additionalProperties": false,
      "properties": {
        "only_gold_supervision": {"const": "parent_video_binary_label", "type": "string"},
        "segment_gold_exists": {"const": false, "type": "boolean"},
        "segment_gold_used": {"const": false, "type": "boolean"},
        "zero_counters": {"$ref": "#/definitions/zero_counters"}
      },
      "required": ["only_gold_supervision", "segment_gold_exists", "segment_gold_used", "zero_counters"],
      "type": "object"
    },
    "halfspace_normals": {
      "additionalProperties": false,
      "properties": {
        "present": {"const": true, "type": "boolean"},
        "robust_constraints_enabled": {"const": false, "type": "boolean"},
        "sign_convention": {"const": "nonnegative multipliers for <= halfspaces", "type": "string"},
        "total_multiplier_l1": {"minimum": 0, "type": "number"}
      },
      "required": ["present", "robust_constraints_enabled", "sign_convention", "total_multiplier_l1"],
      "type": "object"
    },
    "hashes": {"$ref": "#/definitions/hashes"},
    "injection_results_expected": {
      "additionalProperties": false,
      "properties": {
        "finite_vi_only_attempted_acceptance": {"const": "REJECT", "type": "string"},
        "forbidden_path": {"const": "REJECT", "type": "string"},
        "incomplete_cone_family": {"const": "REJECT", "type": "string"},
        "invalid_extra_missing_schema_fields": {"const": "REJECT", "type": "string"},
        "nan_overflow": {"const": "REJECT", "type": "string"},
        "perturbed_artifact_source_operator_hash": {"const": "REJECT", "type": "string"},
        "rank_failure": {"const": "REJECT", "type": "string"},
        "wrong_dual_sign": {"const": "REJECT", "type": "string"}
      },
      "required": [
        "nan_overflow",
        "perturbed_artifact_source_operator_hash",
        "invalid_extra_missing_schema_fields",
        "wrong_dual_sign",
        "incomplete_cone_family",
        "forbidden_path",
        "rank_failure",
        "finite_vi_only_attempted_acceptance"
      ],
      "type": "object"
    },
    "metric": {
      "additionalProperties": false,
      "properties": {
        "G_block": {"const": "identity_on_symmetric_Gram_entries", "type": "string"},
        "H_positive_definite": {"const": true, "type": "boolean"},
        "lambda_struct": {"exclusiveMinimum": 0, "type": "number"},
        "r_struct_block": {"const": "lambda_struct_identity", "type": "string"}
      },
      "required": ["G_block", "r_struct_block", "lambda_struct", "H_positive_definite"],
      "type": "object"
    },
    "movement_metrics": {
      "additionalProperties": false,
      "properties": {
        "fro_norm_G_star_minus_G0": {"type": "number"},
        "max_abs_offdiag_change": {"type": "number"},
        "positive_threshold": {"type": "number"},
        "structural_adjoint_offdiag_l2": {"type": "number"},
        "structural_dual_l2": {"type": "number"},
        "structural_residual_l2": {"type": "number"}
      },
      "required": [
        "fro_norm_G_star_minus_G0",
        "max_abs_offdiag_change",
        "positive_threshold",
        "structural_dual_l2",
        "structural_residual_l2",
        "structural_adjoint_offdiag_l2"
      ],
      "type": "object"
    },
    "no_success_claim": {"const": true, "type": "boolean"},
    "orth_cap_matrix": {
      "additionalProperties": false,
      "properties": {
        "above_cap": {"enum": ["PASS", "FAIL"], "type": "string"},
        "at_cap": {"enum": ["PASS", "FAIL"], "type": "string"},
        "below_cap": {"enum": ["PASS", "FAIL"], "type": "string"},
        "sign_basis_alignment": {"enum": ["PASS", "FAIL"], "type": "string"}
      },
      "required": ["below_cap", "at_cap", "above_cap", "sign_basis_alignment"],
      "type": "object"
    },
    "payload_sha256": {"type": "string"},
    "primal": {
      "additionalProperties": false,
      "properties": {
        "G0": {"$ref": "#/definitions/float_matrix"},
        "G_star": {"$ref": "#/definitions/float_matrix"},
        "objective_value": {"type": "number"},
        "r_struct": {"$ref": "#/definitions/float_array"},
        "residual_summaries": {"items": {"$ref": "#/definitions/named_metric"}, "type": "array"}
      },
      "required": ["G0", "G_star", "r_struct", "objective_value", "residual_summaries"],
      "type": "object"
    },
    "psd_normal": {
      "additionalProperties": false,
      "properties": {
        "S_psd": {"$ref": "#/definitions/float_matrix"},
        "complementarity_trace": {"maximum": 0.000001, "minimum": 0, "type": "number"},
        "dual_lambda_min": {"minimum": -0.0000001, "type": "number"},
        "normal_contribution_sign": {"const": "v_psd=-S_psd", "type": "string"},
        "present": {"const": true, "type": "boolean"}
      },
      "required": ["present", "S_psd", "normal_contribution_sign", "dual_lambda_min", "complementarity_trace"],
      "type": "object"
    },
    "rank_failure_probe": {
      "additionalProperties": false,
      "properties": {
        "case_id": {"const": "RANK_FAILURE_RETURNS_NULL", "type": "string"},
        "d": {"const": 2, "type": "integer"},
        "expected_status": {"const": "ENCODER_RANK_GATE_FAIL", "type": "string"},
        "factor_returned_null": {"const": true, "type": "boolean"},
        "rank_audit": {"$ref": "#/definitions/rank_audit"}
      },
      "required": ["case_id", "d", "factor_returned_null", "rank_audit", "expected_status"],
      "type": "object"
    },
    "run_id": {"const": "LBSCGP-GLOBAL-G0-M0-SYNTH-KKT-v1", "type": "string"},
    "schema_fixture_results": {
      "additionalProperties": false,
      "properties": {
        "invalid_schema": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "fixture": {"type": "string"},
              "reason": {"type": "string"},
              "status": {"const": "REJECT", "type": "string"}
            },
            "required": ["fixture", "status", "reason"],
            "type": "object"
          },
          "minItems": 3,
          "type": "array"
        },
        "unresolved_values": {
          "additionalProperties": false,
          "properties": {
            "encoded_row_norm_positive": {"const": true, "type": "boolean"},
            "schema_status": {"const": "PASS", "type": "string"},
            "state": {"const": "unresolved", "type": "string"}
          },
          "required": ["state", "schema_status", "encoded_row_norm_positive"],
          "type": "object"
        }
      },
      "required": ["invalid_schema", "unresolved_values"],
      "type": "object"
    },
    "schema_version": {"const": "lb_scgp_global_r2_synth_kkt_manifest_v1", "type": "string"},
    "slurm_policy": {
      "additionalProperties": false,
      "properties": {
        "conda_env": {"const": "HateVideo", "type": "string"},
        "cpu": {"const": 8, "type": "integer"},
        "gpu": {"const": 0, "type": "integer"},
        "job_id": {"type": "string"},
        "no_time_flag": {"const": true, "type": "boolean"},
        "ram_gb": {"const": 64, "type": "integer"},
        "required": {"const": true, "type": "boolean"}
      },
      "required": ["required", "conda_env", "job_id", "cpu", "ram_gb", "gpu", "no_time_flag"],
      "type": "object"
    },
    "soc_normals": {
      "additionalProperties": false,
      "properties": {
        "class_trust": {"$ref": "#/definitions/normal_block"},
        "row_trust": {"$ref": "#/definitions/normal_block"}
      },
      "required": ["row_trust", "class_trust"],
      "type": "object"
    },
    "source_manifest_path": {"type": "string"},
    "stationarity": {
      "additionalProperties": false,
      "properties": {
        "acceptance_tolerance": {"const": 0.000001, "type": "number"},
        "gradient_norm": {"minimum": 0, "type": "number"},
        "normal_sum_norm": {"minimum": 0, "type": "number"},
        "normalized_residual": {"maximum": 0.000001, "minimum": 0, "type": "number"},
        "residual_norm": {"maximum": 0.000001, "minimum": 0, "type": "number"},
        "status": {"enum": ["PASS", "FAIL"], "type": "string"}
      },
      "required": [
        "status",
        "residual_norm",
        "normalized_residual",
        "gradient_norm",
        "normal_sum_norm",
        "acceptance_tolerance"
      ],
      "type": "object"
    },
    "terminal_state": {"enum": ["PRODUCED_PENDING_INDEPENDENT_VERIFY", "FAIL"], "type": "string"}
  },
  "required": [
    "schema_version",
    "artifact_schema_id",
    "run_id",
    "terminal_state",
    "authorized_boundary",
    "no_success_claim",
    "slurm_policy",
