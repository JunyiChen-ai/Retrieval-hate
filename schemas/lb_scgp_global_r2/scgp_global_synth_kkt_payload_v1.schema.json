  "properties": {
    "acceptance": {
      "additionalProperties": false,
      "properties": {
        "acceptance_path": {"const": "serialized_h_metric_normal_cone_kkt", "type": "string"},
        "finite_vi_can_accept": {"const": false, "type": "boolean"},
        "producer_status": {"enum": ["PASS_CANDIDATE", "FAIL"], "type": "string"},
        "semantic_verifier_required": {"const": true, "type": "boolean"}
      },
      "required": ["producer_status", "semantic_verifier_required", "acceptance_path", "finite_vi_can_accept"],
      "type": "object"
    },
    "access_ledger_path": {"type": "string"},
    "affine_normals": {
      "additionalProperties": false,
      "properties": {
        "diagonal_affine_dual": {"$ref": "#/definitions/float_array"},
        "normal_G_fro_norm": {"minimum": 0, "type": "number"},
        "normal_r_l2_norm": {"minimum": 0, "type": "number"},
        "structural_nu": {"$ref": "#/definitions/float_array"},
        "structural_sign_convention": {"const": "normal_G=-A_struct^T nu, normal_r=nu", "type": "string"},
        "symmetry_affine_dual_fro_norm": {"minimum": 0, "type": "number"}
      },
      "required": [
        "symmetry_affine_dual_fro_norm",
        "diagonal_affine_dual",
