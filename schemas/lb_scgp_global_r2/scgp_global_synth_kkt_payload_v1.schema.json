    "rank_audit": {
      "additionalProperties": false,
      "properties": {
        "eps_rank": {"type": "number"},
        "failure_policy": {"type": "string"},
        "lambda_d": {"type": "number"},
        "lambda_dplus1": {"type": "number"},
        "lambda_min": {"type": "number"},
        "negative_eigenmass": {"type": "number"},
        "omitted_positive_eigenmass_beyond_d": {"type": "number"},
        "positive_eigenmass": {"type": "number"},
        "rank_eps": {"minimum": 0, "type": "integer"},
        "reconstruction_residual": {"type": "number"},
        "status": {"enum": ["PASS", "ENCODER_RANK_GATE_FAIL"], "type": "string"},
        "tail_ratio": {"type": "number"}
