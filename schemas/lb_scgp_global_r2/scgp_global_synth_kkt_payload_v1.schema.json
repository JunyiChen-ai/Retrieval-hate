      "required": [
        "lambda_d",
        "lambda_dplus1",
        "rank_eps",
        "eps_rank",
        "positive_eigenmass",
        "omitted_positive_eigenmass_beyond_d",
        "tail_ratio",
        "negative_eigenmass",
        "lambda_min",
        "reconstruction_residual",
        "status",
        "failure_policy"
