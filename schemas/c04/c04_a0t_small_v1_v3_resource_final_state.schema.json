{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c04_a0t_small_v1_v3_resource_final_state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "implementation_version",
    "original_slurm_job_id",
    "reconciler_slurm_job_id",
    "preflight_manifest_sha256",
    "payload_review_sha256",
    "gpu_execution_authorization_sha256",
    "resource_reconciliation_authorization_sha256",
    "allocation_claim_sha256",
    "allocation_entry_marker_sha256",
    "provisional_gpu_usage_sha256",
    "gpu_ledger_pre_reconcile_sha256",
    "gpu_ledger_terminal_sha256",
    "terminal_sacct_state",
    "terminal_sacct_gpu_seconds",
    "aggregate_accounted_gpu_seconds",
    "aggregate_reconciled_terminal_gpu_seconds",
    "cap_gpu_seconds",
    "single_gpu_allocation_count",
    "second_gpu_allocation_authorized",
    "reserved_gpu_seconds",
    "requires_terminal_reconciliation",
    "downstream_review_resource_gate_satisfied",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "c04_resource_final_state_v3"},
    "run_id": {"const": "C04-A0T-SMALL-v1"},
    "implementation_version": {"const": "v3_prospective"},
    "original_slurm_job_id": {"type": "string", "pattern": "^[0-9]+$"},
    "reconciler_slurm_job_id": {"type": "string", "pattern": "^[0-9]+$"},
    "preflight_manifest_sha256": {"$ref": "#/definitions/sha256"},
    "payload_review_sha256": {"$ref": "#/definitions/sha256"},
    "gpu_execution_authorization_sha256": {"$ref": "#/definitions/sha256"},
    "resource_reconciliation_authorization_sha256": {"$ref": "#/definitions/sha256"},
    "allocation_claim_sha256": {"$ref": "#/definitions/sha256"},
    "allocation_entry_marker_sha256": {"$ref": "#/definitions/sha256"},
    "provisional_gpu_usage_sha256": {"$ref": "#/definitions/sha256"},
    "gpu_ledger_pre_reconcile_sha256": {"$ref": "#/definitions/sha256"},
    "gpu_ledger_terminal_sha256": {"$ref": "#/definitions/sha256"},
    "terminal_sacct_state": {"type": "string", "minLength": 1},
    "terminal_sacct_gpu_seconds": {"type": "integer", "minimum": 0},
    "aggregate_accounted_gpu_seconds": {"type": "integer", "minimum": 0},
    "aggregate_reconciled_terminal_gpu_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "cap_gpu_seconds": {"const": 7200},
    "single_gpu_allocation_count": {"const": 1},
    "second_gpu_allocation_authorized": {"const": false},
    "reserved_gpu_seconds": {"const": 0},
    "requires_terminal_reconciliation": {"const": false},
    "downstream_review_resource_gate_satisfied": {"const": true},
    "payload_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
