{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "c04_a0t_small_v1_prompt_record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "dataset",
    "video_id",
    "prompt_form",
    "sequence_index",
    "input",
    "provenance",
    "raw_output",
    "raw_output_sha256",
    "transport_error",
    "parsed",
    "elapsed_seconds",
    "retry_count"
  ],
  "properties": {
    "schema_version": {"const": "c04_a0t_small_prompt_record_v1"},
    "run_id": {"const": "C04-A0T-SMALL-v1"},
    "dataset": {"enum": ["HateMM", "MHC_zh"]},
    "video_id": {"type": "string", "minLength": 1},
    "prompt_form": {"enum": ["A", "B"]},
    "sequence_index": {"type": "integer", "minimum": 0, "maximum": 399},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transcript_sha256",
        "video_sha256",
        "frame_backend",
        "total_frame_indices",
        "requested_indices",
        "frame_decode_failed"
      ],
      "properties": {
        "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "frame_backend": {"enum": ["decord", "pyav", "none"]},
        "total_frame_indices": {"type": "integer", "minimum": 0},
        "requested_indices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {"type": "integer", "minimum": 0}
        },
        "frame_decode_failed": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"type": "boolean"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_manifest_sha256",
        "payload_review_sha256",
        "prompt_sha256",
        "model_snapshot_revision",
        "model_tree_sha256",
        "processor_tree_sha256",
        "teacher_label_read",
        "dev_test_read",
        "ocr_used",
        "external_api_used",
        "cross_dataset_input_used"
      ],
      "properties": {
        "preflight_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_snapshot_revision": {"const": "cc594898137f460bfe9f0759e9844b3ce807cfb5"},
        "model_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "processor_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "teacher_label_read": {"const": false},
        "dev_test_read": {"const": false},
        "ocr_used": {"const": false},
        "external_api_used": {"const": false},
        "cross_dataset_input_used": {"const": false}
      }
    },
    "raw_output": {"type": "string"},
    "raw_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transport_error": {"const": ""},
    "parsed": {"$ref": "#/definitions/parsed"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "retry_count": {"const": 0}
  },
  "definitions": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "content", "confidence"],
      "properties": {
        "valid": {"type": "boolean"},
        "content": {"type": "string"},
        "confidence": {
          "anyOf": [
            {"type": "integer", "minimum": 0, "maximum": 4},
            {"type": "null"}
          ]
        }
      }
    },
    "parsed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_valid", "parse_error", "slots"],
      "properties": {
        "form_valid": {"type": "boolean"},
        "parse_error": {"type": "string"},
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["S", "P", "T", "H"],
          "properties": {
            "S": {"$ref": "#/definitions/slot"},
            "P": {"$ref": "#/definitions/slot"},
            "T": {"$ref": "#/definitions/slot"},
            "H": {"$ref": "#/definitions/slot"}
          }
        }
      }
    }
  }
}
