  "statistics_protocol": {
    "tests": [
      "MHC_accuracy",
      "MHC_macro_f1",
      "MHC_zh_accuracy",
      "MHC_zh_macro_f1"
    ],
    "bootstrap_replicates": 10000,
    "rng_seed": 20260712,
    "resampling_hierarchy": [
      "sample seeds with replacement within dataset",
      "sample test videos with replacement within sampled seed stratified by parent_video_binary_label"
    ],
    "uncertainty_unit": "paired video prediction within seed and dataset",
    "paired_statistic": "metric(FULL) - metric(frozen_comparator)",
    "macro_f1_rule": "recompute from resampled confusion counts for both classes",
    "one_sided_lower_bound": "5th percentile of bootstrap deltas; must be > 0",
    "p_value": "(1 + count(delta_b <= 0)) / (B + 1)",
    "holm": {
      "alpha": 0.05,
      "m": 4,
      "order": "ascending p-values across four dataset-by-metric tests",
      "threshold": "0.05/(m-k+1)"
    },
    "joint_success_rule": "observed delta >= 0.030, every paired seed delta positive, bootstrap lower > 0, and Holm rejection for all four tests"
  },
