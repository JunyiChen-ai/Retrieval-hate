  "control_construction_policy": {
    "SHUFFLE": "train-only/OOF bins or preregistered validation-frozen bins before final-test evaluation; final test labels/predictions/margins/errors never used",
    "NOISE": "covariance matched from sealed train certificate encodings only",
    "DIRECT-MOMENT": "direct structural moment route distinct from certificate-feature route",
    "DIRECT-CERT-FEATURE": "direct certificate-feature distillation route distinct from structural moment route",
    "SCALAR-PROPENSITY": "train/OOF or preregistered validation-frozen scalar difficulty/error propensity only",
